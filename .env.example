# Конфигурация Sanau.AI
# Токен вашего Telegram-бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI API Key (для GPT-4o-mini Vision и Whisper-1)
OPENAI_API_KEY=your_openai_api_key_here

# Gemini API Key (альтернативный провайдер ИИ)
GEMINI_API_KEY=

# Настройки базы данных SQLite
DB_PATH=database/sanau.db

# Настройки по умолчанию для интеграций
TELEGRAM_DEFAULT_CHAT_ID=
DEFAULT_WEBHOOK_URL=https://webhook.site/demo-sanau
